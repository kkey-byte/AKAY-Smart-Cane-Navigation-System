rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All location-history access uses the trusted backend, which checks the
    // PostgreSQL profile and active caregiver consent on each request.
    match /navigators/{uid} {
      allow read, write: if false;
      match /trips/{tripId} {
        allow read, write: if false;
        match /points/{pointId} { allow read, write: if false; }
      }
    }
  }
}
