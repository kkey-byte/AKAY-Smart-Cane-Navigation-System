rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy source data is retained for operator-only import. Current history
    // uses PostgreSQL behind the consent-checked API, never direct client reads.
    match /navigators/{uid} {
      allow read, write: if false;
      match /trips/{tripId} {
        allow read, write: if false;
        match /points/{pointId} { allow read, write: if false; }
      }
    }
    // Retired grants are server-only migration archives, never live consent.
    match /legacy_rtdb/{node}/records/{uid} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
