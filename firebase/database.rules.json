{
  "rules": {
    "navigation_live": {
      ".read": false,
      ".write": false
    },
    "breadcrumb_trips": {
      ".read": false,
      ".write": false
    },
    "breadcrumb_shares": {
      ".read": false,
      ".write": false
    },
    "breadcrumb_links": {
      ".read": false,
      ".write": false
    },
    "live_location": {
      ".read": false,
      ".write": false
    },
    "phone_location": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !root.child('deleted_location_accounts').child($uid).exists()",
        ".validate": "newData.hasChildren(['latitude','longitude','timestamp','source']) && newData.child('source').val() === 'phone_gps' && newData.child('latitude').isNumber() && newData.child('latitude').val() >= -90 && newData.child('latitude').val() <= 90 && newData.child('longitude').isNumber() && newData.child('longitude').val() >= -180 && newData.child('longitude').val() <= 180 && newData.child('timestamp').isNumber() && newData.child('timestamp').val() >= now - 300000 && newData.child('timestamp').val() <= now + 30000 && (!data.exists() || newData.child('timestamp').val() > data.child('timestamp').val())",
        "latitude": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "longitude": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "source": {
          ".validate": "newData.val() === 'phone_gps'"
        },
        "speed": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "heading": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360"
        },
        "accuracy": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "cane_location": {
      ".read": false,
      ".write": false
    },
    "deleted_location_accounts": {
      ".read": false,
      ".write": false
    },
    "destination_assignments": {
      ".read": false,
      ".write": false
    },
    ".read": false,
    ".write": false,
    "cane_status": {
      ".read": false,
      ".write": false
    },
    "urgent_signals": {
      ".read": false,
      ".write": false
    }
  }
}